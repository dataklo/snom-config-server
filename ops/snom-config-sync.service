[Unit]
Description=Sync Snom config from private GitHub repository
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/ops/sync-config.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=yes
LockPersonality=yes
ReadWritePaths=@SITE_ROOT@/private/config /var/lib/snom-config-server /var/lock /tmp

[Install]
WantedBy=multi-user.target
